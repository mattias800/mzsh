#!/usr/bin/env bash
set -euo pipefail

# mzsh: install recommended dependencies on macOS via Homebrew
# Safe to re-run; will skip already installed packages.
# Individual jobs are non-fatal: failures are recorded and reported at the end
# so that one failing job (e.g. brew bundle while Docker is running) does not
# prevent the remaining jobs from running.

FAILED_JOBS=()

record_failure() {
  FAILED_JOBS+=("$1")
  echo "[mzsh] WARNING: job failed: $1 (continuing)" >&2
}

# Ensure Homebrew exists and is on PATH (install if missing)
ensure_brew() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi
  echo "[mzsh] Homebrew not found; installing (non-interactive)"
  NONINTERACTIVE=1 /bin/bash -c "$(/usr/bin/curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Detect brew binary path (Apple Silicon vs Intel)
  local brew_bin=""
  if [ -x /opt/homebrew/bin/brew ]; then
    brew_bin=/opt/homebrew/bin/brew
  elif [ -x /usr/local/bin/brew ]; then
    brew_bin=/usr/local/bin/brew
  else
    brew_bin="$(command -v brew || true)"
  fi
  if [ -z "${brew_bin}" ]; then
    echo "[mzsh] ERROR: Homebrew installation appears to have failed (brew not found on PATH)." >&2
    exit 1
  fi

  # shellenv for current session
  eval "$(${brew_bin} shellenv)"

  # Persist shellenv in ~/.zprofile if not already present
  local ZPROFILE="$HOME/.zprofile"
  local SHELLENV_LINE="eval \"\$(${brew_bin} shellenv)\""
  if [ ! -f "$ZPROFILE" ] || ! grep -Fq "$SHELLENV_LINE" "$ZPROFILE"; then
    echo "[mzsh] Appending Homebrew shellenv to ~/.zprofile"
    printf "\n%s\n" "$SHELLENV_LINE" >> "$ZPROFILE"
  fi
}

ensure_brew

# Use Brewfile for dependency management
REPO_DIR="${MZSH_DIR:-$HOME/.mzsh}"
BREWFILE="$REPO_DIR/Brewfile"
if [ ! -f "$BREWFILE" ]; then
  echo "[mzsh] ERROR: Brewfile not found at $BREWFILE" >&2
  exit 1
fi

echo "[mzsh] Installing/updating packages from $BREWFILE"

# Work around stale/removed taps that can break brew operations
if brew tap | grep -q '^homebrew/homebrew-cask-drivers$'; then
  echo "[mzsh] Untapping deprecated tap homebrew/homebrew-cask-drivers"
  brew untap homebrew/homebrew-cask-drivers || true
fi
if brew tap | grep -q '^homebrew/cask-drivers$'; then
  echo "[mzsh] Untapping deprecated tap homebrew/cask-drivers"
  brew untap homebrew/cask-drivers || true
fi

# Determine if --no-lock is supported
NO_LOCK_FLAG=""
if brew bundle --help 2>/dev/null | grep -q -- "--no-lock"; then
  NO_LOCK_FLAG="--no-lock"
fi

# Avoid auto-update during bundle to reduce failure surface on older setups
HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install ${NO_LOCK_FLAG} --file "$BREWFILE" || record_failure "brew bundle"

# Install zsh-interactive-cd into vendor path (no OMZ required)
VENDOR_DIR="$HOME/.local/share/zsh-interactive-cd"
if [ -d "$VENDOR_DIR/.git" ]; then
  echo "[mzsh] zsh-interactive-cd already installed at $VENDOR_DIR"
else
  echo "[mzsh] Installing zsh-interactive-cd plugin into $VENDOR_DIR"
  mkdir -p "$HOME/.local/share"
  git clone --depth=1 https://github.com/changyuheng/zsh-interactive-cd "$VENDOR_DIR" || record_failure "zsh-interactive-cd install"
fi

# Setup Docker Compose as a Docker CLI plugin (enables `docker compose` command)
if command -v docker >/dev/null 2>&1 && command -v docker-compose >/dev/null 2>&1; then
  DOCKER_PLUGINS_DIR="$HOME/.docker/cli-plugins"
  DOCKER_COMPOSE_PATH="$(command -v docker-compose)"
  mkdir -p "$DOCKER_PLUGINS_DIR"
  if [ ! -L "$DOCKER_PLUGINS_DIR/docker-compose" ]; then
    echo "[mzsh] Setting up docker-compose as Docker CLI plugin"
    ln -sf "$DOCKER_COMPOSE_PATH" "$DOCKER_PLUGINS_DIR/docker-compose"
  fi
fi

# Install tmux configuration
echo "[mzsh] Installing tmux configuration"
TMUX_CONF="$REPO_DIR/config/tmux/tmux.conf"
if [ -f "$TMUX_CONF" ]; then
  if [ -f "$HOME/.tmux.conf" ]; then
    echo "[mzsh] Backing up existing ~/.tmux.conf to ~/.tmux.conf.bak"
    cp "$HOME/.tmux.conf" "$HOME/.tmux.conf.bak" || record_failure "tmux config backup"
  fi
  if cp "$TMUX_CONF" "$HOME/.tmux.conf"; then
    echo "[mzsh] tmux config installed to ~/.tmux.conf"
  else
    record_failure "tmux config install"
  fi
else
  echo "[mzsh] WARNING: tmux config not found at $TMUX_CONF"
fi

# Install neovim configuration
echo "[mzsh] Installing neovim configuration"
NVIM_CONFIG_SRC="$REPO_DIR/config/nvim"
NVIM_CONFIG_DEST="$HOME/.config/nvim"
if [ -d "$NVIM_CONFIG_SRC" ]; then
  mkdir -p "$NVIM_CONFIG_DEST"
  if [ -d "$NVIM_CONFIG_DEST" ] && [ "$(ls -A "$NVIM_CONFIG_DEST")" ]; then
    BACKUP_DIR="$HOME/.config/nvim.bak-$(date +%s)"
    echo "[mzsh] Backing up existing nvim config to $BACKUP_DIR"
    mv "$NVIM_CONFIG_DEST" "$BACKUP_DIR" || record_failure "nvim config backup"
    mkdir -p "$NVIM_CONFIG_DEST"
  fi
  if cp -r "$NVIM_CONFIG_SRC"/* "$NVIM_CONFIG_DEST/"; then
    echo "[mzsh] Neovim config installed to ~/.config/nvim"
  else
    record_failure "nvim config install"
  fi
else
  echo "[mzsh] WARNING: Neovim config not found at $NVIM_CONFIG_SRC"
fi

# Disable conflicting macOS Services keyboard shortcuts (⌘⇧A, ⌘⇧M)
"$REPO_DIR/bin/mzsh-disable-macos-shortcuts" || record_failure "disable macOS shortcuts"

# Use F1, F2, etc. as standard function keys (instead of media keys)
if [ "$(uname)" = "Darwin" ]; then
  echo "[mzsh] Setting keyboard to use F1, F2, etc. as standard function keys"
  defaults write -g com.apple.keyboard.fnState -bool true || record_failure "keyboard fnState"
  # Apply without logout
  if [ -x /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings ]; then
    /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u >/dev/null 2>&1 || true
  fi
fi

if [ ${#FAILED_JOBS[@]} -gt 0 ]; then
  echo "[mzsh] Done, but ${#FAILED_JOBS[@]} job(s) failed:" >&2
  for job in "${FAILED_JOBS[@]}"; do
    echo "[mzsh]   - $job" >&2
  done
  exit 1
fi

echo "[mzsh] Done. If needed, restart your terminal."
