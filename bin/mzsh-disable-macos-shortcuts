#!/usr/bin/env bash
set -euo pipefail

# Disable macOS Services keyboard shortcuts that conflict with common editor
# bindings. macOS ships ⌘⇧A ("Search man Page Index in Terminal") and ⌘⇧M
# ("Open man Page in Terminal") as global Services shortcuts, which fire from
# any app and pop up a Terminal window running `apropos`/`man` on the current
# selection. This script disables them by editing NSServicesStatus in
# ~/Library/Preferences/pbs.plist (the same key macOS writes when you uncheck
# the service in System Settings → Keyboard → Keyboard Shortcuts → Services).
#
# Safe to re-run; idempotent.

if [ "$(uname)" != "Darwin" ]; then
  echo "[mzsh] disable-macos-shortcuts: not macOS, skipping" >&2
  exit 0
fi

SERVICES=(
  "com.apple.Terminal - Search man Page Index in Terminal - searchManPages"
  "com.apple.Terminal - Open man Page in Terminal - openManPage"
)

DISABLED_DICT='{ "enabled_context_menu" = 0; "enabled_services_menu" = 0; "key_equivalent" = ""; "presentation_modes" = { "ContextMenu" = 0; "ServicesMenu" = 0; }; }'

for key in "${SERVICES[@]}"; do
  echo "[mzsh] Disabling macOS service shortcut: $key"
  defaults write pbs NSServicesStatus -dict-add "$key" "$DISABLED_DICT"
done

# Refresh the Services registry so changes take effect without logout
if [ -x /System/Library/CoreServices/pbs ]; then
  /System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
fi

echo "[mzsh] Done. You may need to restart running apps for the change to apply there."
