#!/usr/bin/env bash
set -euo pipefail

# Disable macOS keyboard shortcuts that conflict with the tools mzsh installs.
#
# Services shortcuts: macOS ships ⌘⇧A ("Search man Page Index in Terminal")
# and ⌘⇧M ("Open man Page in Terminal") as global Services shortcuts, which
# fire from any app and pop up a Terminal window running `apropos`/`man` on
# the current selection. This script disables them by editing NSServicesStatus
# in ~/Library/Preferences/pbs.plist (the same key macOS writes when you
# uncheck the service in System Settings → Keyboard → Keyboard Shortcuts →
# Services).
#
# Spotlight hotkeys: mzsh installs Raycast as the launcher, so the Spotlight
# hotkeys ⌘Space ("Show Spotlight search") and ⌥⌘Space ("Show Finder search
# window") are disabled to free them up for Raycast. They are symbolic hotkeys
# 64 and 65 in ~/Library/Preferences/com.apple.symbolichotkeys.plist.
#
# Safe to re-run; idempotent.

if [ "$(uname)" != "Darwin" ]; then
  echo "[mzsh] disable-macos-shortcuts: not macOS, skipping" >&2
  exit 0
fi

SERVICES=(
  "com.apple.Terminal - Search man Page Index in Terminal - searchManPages"
  "com.apple.Terminal - Open man Page in Terminal - openManPage"
)

DISABLED_DICT='{ "enabled_context_menu" = 0; "enabled_services_menu" = 0; "key_equivalent" = ""; "presentation_modes" = { "ContextMenu" = 0; "ServicesMenu" = 0; }; }'

for key in "${SERVICES[@]}"; do
  echo "[mzsh] Disabling macOS service shortcut: $key"
  defaults write pbs NSServicesStatus -dict-add "$key" "$DISABLED_DICT"
done

# Refresh the Services registry so changes take effect without logout
if [ -x /System/Library/CoreServices/pbs ]; then
  /System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
fi

# Disable Spotlight hotkeys (Raycast is the launcher).
# 64 = Show Spotlight search (⌘Space), 65 = Show Finder search window (⌥⌘Space).
# The value dict (key code 49 = Space + modifier mask) is kept so the shortcut
# stays visible-but-unchecked in System Settings instead of disappearing.
disable_symbolic_hotkey() {
  local id="$1" modifiers="$2"
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$id" "
    <dict>
      <key>enabled</key><false/>
      <key>value</key>
      <dict>
        <key>type</key><string>standard</string>
        <key>parameters</key>
        <array>
          <integer>65535</integer>
          <integer>49</integer>
          <integer>${modifiers}</integer>
        </array>
      </dict>
    </dict>
  "
}

echo "[mzsh] Disabling Spotlight hotkeys (use Raycast instead)"
disable_symbolic_hotkey 64 1048576   # ⌘Space - Show Spotlight search
disable_symbolic_hotkey 65 1572864   # ⌥⌘Space - Show Finder search window

# Make the symbolic hotkey changes take effect without logout
if [ -x /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings ]; then
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u >/dev/null 2>&1 || true
fi

echo "[mzsh] Done. You may need to restart running apps for the change to apply there."
